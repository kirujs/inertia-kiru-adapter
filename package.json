    "eslint-plugin-react-refresh": "^0.5.3",
    "kiru": "^1.5.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "5.0.2",
    "vite-plugin-kiru": "^1.2.3"
  },
  "dependencies": {
    "@inertiajs/core": "^3.4.0",
    "es-toolkit": "^1.48.1",
    "laravel-precognition": "^2.0.0"
